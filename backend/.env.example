# Copy this file to .env and fill in real local values. Never commit .env.

# SQLite file used by Prisma — no separate database server to install or run.
# The path is relative to the prisma/ folder, so this creates backend/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# HTTP port the API listens on.
PORT=4000

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET="dev-only-change-me-please"

# How long an issued JWT stays valid (e.g. "7d", "12h", "30m").
JWT_EXPIRES_IN="7d"

# SMTP connection for sending OTP emails. Defaults to Mailpit, a local SMTP
# catcher (see README section 2.1 for how to install/run it) — no auth needed,
# web UI at http://localhost:8025. Leave SMTP_HOST blank to instead print OTP
# emails to this server's own console (a fallback for when Mailpit isn't running).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false

# To send to a REAL inbox instead of Mailpit, point the above at a real
# provider and fill in SMTP_USER/SMTP_PASSWORD (leave both blank for Mailpit,
# which needs no auth). Example for Gmail — see README section 2.1 for the
# exact steps to generate an App Password (a normal Gmail password won't work):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER="you@gmail.com"
#   SMTP_PASSWORD="16-character app password"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PadosiPro <no-reply@padosipro.local>"

# OTP behaviour (matches assignment spec; override only for local testing).
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Comma-separated list of origins allowed to call the API (mobile dev client, etc).
CORS_ORIGIN="*"
