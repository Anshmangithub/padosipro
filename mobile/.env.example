# Copy to .env (Expo automatically inlines EXPO_PUBLIC_* vars at build/start time).
#
# Point this at your backend. Which host works depends on how you're running the app:
#   - Android emulator: http://10.0.2.2:4000/api  (emulator's alias for your machine's localhost)
#   - iOS simulator:    http://localhost:4000/api
#   - Physical device (Expo Go): http://<your-computer's-LAN-IP>:4000/api  (device and computer must be on the same Wi-Fi)
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api"
